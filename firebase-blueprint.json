{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A potential client inquiry from the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the lead" },
        "email": { "type": "string", "format": "email", "description": "The contact email" },
        "projectType": { "type": "string", "description": "Type of project (web, ecommerce, design)" },
        "budget": { "type": "string", "description": "Estimated budget range" },
        "message": { "type": "string", "description": "Detailed message from the lead" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the lead was created" }
      },
      "required": ["name", "email", "projectType", "budget", "message", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A scheduled meeting",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "The date of the meeting (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "The time slot selected" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the booking was made" },
        "userEmail": { "type": "string", "format": "email", "description": "Email of the user who booked (if available)" }
      },
      "required": ["date", "time", "createdAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of client inquiries"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of scheduled meetings"
    }
  }
}
