# GEMINI_API_KEY: Required for AI Chatbot.
# 1. Get a key at: https://aistudio.google.com/app/apikey
# 2. For local dev: Add your key to .env (not .env.example)
# 3. For AI Studio preview: Add to Secrets panel in Settings.
# 4. For Netlify/Vercel: Add to Site Settings -> Environment Variables.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: Your production URL
APP_URL=https://dearsofttechie.netlify.app
